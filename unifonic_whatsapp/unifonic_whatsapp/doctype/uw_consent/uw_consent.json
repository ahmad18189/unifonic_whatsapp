    {
      "role": "Unifonic Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "email": 0,
      "export": 0,
      "print": 0,
      "share": 0
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
